# Copy to .env.local and fill in. Every key here is required (except where marked optional) — src/lib/env.ts
# validates them at module load, so a missing one fails the build. See §10.

# Supabase — Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never import this into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email for lead notifications
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=info@snehaconstruction.com

# Shared secret for the Supabase database webhook that hits /api/revalidate.
# Minimum 16 characters. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Canonical origin, no trailing slash
NEXT_PUBLIC_SITE_URL=https://snehaconstruction.com

# Optional — Google Analytics 4 measurement ID (Admin → Data streams → Web).
# Leave empty to disable analytics entirely (local dev, previews).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
